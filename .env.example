# Credenciais da Embrapa ClimAPI (AgroAPI)
# Gere o par de chaves em https://www.agroapi.cnptia.embrapa.br apos assinar a ClimAPI.
# Copie este arquivo para .env e preencha. NUNCA faca commit do .env.

EMBRAPA_CONSUMER_KEY=coloque_sua_consumer_key_aqui
EMBRAPA_CONSUMER_SECRET=coloque_seu_consumer_secret_aqui

# Alternativa: se voce ja tem o base64 de "chave:segredo" pronto, use:
# EMBRAPA_BASIC=base64_de_chave_dois_pontos_segredo

# Opcionais (so mude se a Embrapa alterar os enderecos/codigos):
# EMBRAPA_TOKEN_URL=https://api.cnptia.embrapa.br/token
# EMBRAPA_BASE_URL=https://api.cnptia.embrapa.br/climapi/v1
# EMBRAPA_LIMITE_REQUISICOES=500
